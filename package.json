{
  "name": "puppeteer-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Puppeteer — vendored from modelcontextprotocol/servers-archived (src/puppeteer), standalone for Hephaistos infra",
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "puppeteer-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/*.js",
    "start": "node dist/index.js",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.3",
    "puppeteer": "^25.12.0"
  },
  "devDependencies": {
    "shx": "^0.3.4",
    "typescript": "^5.6.2"
  }
}
